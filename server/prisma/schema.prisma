// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum AccountType {
  personal
  shared
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model emailaccount {
  id             String      @id @unique @default(uuid())
  organizationId String?
  userId         String?
  type           AccountType @default(personal)
  createdAt      DateTime    @default(now())
  accessedAt     DateTime    @default(now())
  address        String      @unique
  domainId       String?
  emails         email[]
  folders        folder[]
  color          String     @default("default")
  contacts       contact[]
  calendars      calendar[]
  invited        invitee[]
  groupId        String?

  tasksNotesLists TasksNotesList[]
  tasks task[]
  notes Note[]
}

model folder {
  id        String       @id @unique @default(uuid())
  name      String
  type      String
  accountId String
  createdAt DateTime     @default(now())
  emails    email[]
  account   emailaccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model email {
  id        String       @id @unique @default(uuid())
  from      String
  to        String
  subject   String
  date      DateTime     @default(now())
  accountId String
  folderId  String
  inReplyTo String?
  name      String?
  unseen    Boolean      @default(false)
  email     Json
  account   emailaccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder    folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  emailid   String
}

model contact {
  id        String       @id @unique @default(uuid())
  name      String
  info      Json
  accountId String
  account   emailaccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model calendar {
  id            String       @id @unique @default(uuid())
  name          String
  accountId     String
  account       emailaccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  events        event[]
  invitedEvents invitee[]
}

model event {
  id         String    @id @unique @default(uuid())
  name       String
  calendarId String
  calendar   calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  invitees   invitee[]
  start      DateTime
  end        DateTime
  data       Json
  allDay     Boolean   @default(false)
}

model invitee {
  id         String       @id @unique @default(uuid())
  name       String
  accountId  String
  eventId    String
  calendarId String?
  calendar   calendar?    @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  event      event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  account    emailaccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model distributionlist {
  id        String       @id @unique @default(uuid())
  name      String
  notes     String?
  address   String
  members   distributionlistmember[]
}

model distributionlistmember {
  id              String              @id @unique @default(uuid())
  name            String
  email           String
  distributionListId String
  distributionList distributionlist @relation(fields: [distributionListId], references: [id], onDelete: Cascade)
}

model Note {
  id        String       @id @unique @default(uuid())
  title     String
  content   String
  accountId String
  config    Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  
  listId    String?
  list      TasksNotesList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  
  account   emailaccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model TasksNotesList {
  id        String       @id @unique @default(uuid())
  name      String
  accountId String
  account   emailaccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tasks     task[]
  notes     Note[]
}

model task {
  id        String       @id @unique @default(uuid())
  name      String
  completed Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  config    Json?
  listId    String?
  list      TasksNotesList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  accountId String
  account   emailaccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}